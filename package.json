{
  "name": "mocklab",
  "version": "1.6.2",
  "description": "File-based mock API server with file-based routing",
  "main": "server/index.js",
  "bin": {
    "mocklab": "./bin/mocklab.js",
    "mocklab-server": "./bin/mocklab-server.js",
    "mocklab-dev": "./bin/mocklab-dev.js"
  },
  "scripts": {
    "start": "node bin/mocklab.js",
    "server": "node bin/mocklab-server.js",
    "dev": "node bin/mocklab-dev.js",
    "test": "npm run test:unit && npm run test:func",
    "test:func": "node --test tests/functional/index.js",
    "test:unit": "node --test tests/unit/*.unit.js"
  },
  "keywords": [
    "mock",
    "server",
    "api",
    "testing",
    "express",
    "mock-server",
    "testing-tools"
  ],
  "author": "Dmitry Shlepkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DmitryShlepkin/mocklab"
  },
  "bugs": {
    "url": "https://github.com/DmitryShlepkin/mocklab/issues"
  },
  "homepage": "https://github.com/DmitryShlepkin/mocklab",
  "dependencies": {
    "express": "^4.18.2"
  },
  "files": [
    "bin/",
    "server/",
    "ui/",
    "README.md"
  ],
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
